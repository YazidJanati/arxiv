{
  "name": "arxiv-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet macOS reader for daily arXiv papers.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "bundle": "npm run build && bash scripts/build-macos.sh",
    "install:macos": "npm run bundle && bash scripts/install-macos.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "~5.9.0",
    "vite": "^6.1.0"
  }
}
